<idea-plugin url="https://github.com/tanvoid0/node-spark">
    <id>com.nodespark.node-spark</id>
    <name>NodeSpark</name>
    <vendor email="tanvoid0@gmail.com" url="https://tanvoid0.com">NodeSpark</vendor>

    <description><![CDATA[
        JavaScript and TypeScript test runner for IntelliJ IDEA Community &mdash; no WebStorm
        licence needed.<br/>
        Runs Jest, Vitest, Mocha and <code>node --test</code> with a real pass/fail test tree,
        gutter run icons, package.json script running, a CDP debugger, ESLint/Prettier and
        lcov coverage.<br/><br/>
        Everything runs against the tools the project already installs in its own
        <code>node_modules</code> &mdash; nothing is downloaded and nothing is installed into your
        project. Tools are only executed in projects you have marked as trusted.
    ]]></description>

    <change-notes><![CDATA[
        <b>0.3.1</b>
        <ul>
          <li>Same code as 0.3.0, published with the author signature the previous upload was
              missing, so the IDE no longer warns about an unsigned plugin on install.</li>
        </ul>

        <b>0.3.0</b>
        <ul>
          <li>Gutter run/debug icons no longer depend on a JavaScript PSI, so they finally appear in
              IntelliJ IDEA Community, where <code>.js</code> is owned by TextMate. They also update
              as you type and turn into a tick or a cross when a run finishes.</li>
          <li>Run configurations are named after the whole <code>describe</code> chain
              (<code>UserService &gt; login &gt; returns a token</code>) rather than
              "Run Node Tests", and a gutter arrow on a <code>describe</code> runs that suite.</li>
          <li>Removed the duplicate "Run Node Tests" context-menu entry: the ordinary
              <b>Run '&lt;file&gt;'</b> item does the same thing.</li>
          <li><b>Settings &rarr; NodeSpark</b> now detects the Node.js and npm executables, has a
              file chooser and a <b>Detect</b> button for each, and an absolute path entered there
              overrides both the SDK and PATH.</li>
        </ul>

        <b>0.2.0</b>
        <ul>
          <li>Reformat Code (Ctrl+Alt+L) now runs the project's own Prettier on
              <code>.js/.jsx/.ts/.tsx</code>, and code that differs from Prettier's output is
              highlighted with a "Reformat with Prettier" fix. Both are advisory, both switch off
              under <b>Settings &rarr; NodeSpark &rarr; ESLint / Prettier</b>, and neither does
              anything in a project that has no Prettier of its own.</li>
          <li>ESLint, Prettier and the <code>npm install</code> banner now respect IDE project trust:
              nothing from a project's <code>node_modules</code> is executed until the project is trusted.</li>
          <li>Executables are resolved against PATH rather than the working directory, so a binary
              committed to a repository can no longer shadow the real <code>node</code> or <code>npm</code>.</li>
          <li>Jest, Vitest, Mocha and <code>node --test</code> test trees, gutter run icons,
              package.json script running, CDP debugger and lcov coverage.</li>
        </ul>
    ]]></change-notes>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.lang</depends>

    <!-- Optional: the Java plugin owns the projectImportProvider extension point.
         Without it the plugin still loads, minus the package.json import path. -->
    <depends optional="true" config-file="node-spark-java.xml">com.intellij.modules.java</depends>

    <!-- Optional: LSP4IJ is the LSP client Community does not ship. Without it the plugin still
         loads, minus completion / auto-import / go-to-definition. -->
    <depends optional="true" config-file="node-spark-lsp.xml">com.redhat.devtools.lsp4ij</depends>

    <extensions defaultExtensionNs="com.intellij">

        <!-- Run configuration type -->
        <configurationType
            implementation="com.nodespark.run.NodeTestRunConfigurationType"/>

        <!-- Program runner — required for ExecutionUtil.runConfiguration to dispatch -->
        <programRunner implementation="com.nodespark.run.NodeTestProgramRunner"/>

        <!-- Debug runner: launches node with inspect-brk flag, connects CDP debugger -->
        <programRunner implementation="com.nodespark.debug.NodeTestDebugProgramRunner"/>

        <!-- Line breakpoint type for JS files — enables the gutter and feeds NodeDebugProcess's handler -->
        <xdebugger.breakpointType implementation="com.nodespark.debug.NodeLineBreakpointType"/>

        <!-- Right-click → Run producer -->
        <runConfigurationProducer
            implementation="com.nodespark.run.NodeTestRunConfigurationProducer"/>

        <!-- Gutter play icons. Not a lineMarkerProvider: Community has no JavaScript PSI, so a
             daemon pass never reaches a .js file there and no marker was ever produced. -->
        <editorFactoryListener implementation="com.nodespark.gutter.NodeTestGutterMarkup"/>

        <!-- Settings page -->
        <applicationConfigurable
            parentId="tools"
            instance="com.nodespark.settings.NodeSparkConfigurable"
            id="com.nodespark.settings"
            displayName="NodeSpark"/>

        <applicationService
            serviceImplementation="com.nodespark.settings.NodeSparkSettings"/>

        <!-- Node.js SDK type — appears in Project Structure → SDKs -->
        <sdkType implementation="com.nodespark.sdk.NodeJsSdkType"/>

        <!-- Node.js module type — appears in Project Structure → Modules → Add → New Module,
             and lets a module take a Node.js SDK in its Dependencies tab -->
        <moduleType id="NODE_JS_MODULE"
                    implementationClass="com.nodespark.module.NodeModuleType"
                    classpathProvider="false"/>

        <!-- Per-project SDK selection under Settings → NodeSpark → Node.js SDK -->
        <projectConfigurable
            parentId="com.nodespark.settings"
            instance="com.nodespark.sdk.NodeProjectSdkConfigurable"
            id="com.nodespark.sdk"
            displayName="Node.js SDK"/>

        <!-- Per-project service storing the chosen SDK name -->
        <projectService
            serviceImplementation="com.nodespark.sdk.NodeProjectSdkService"/>

        <!-- Plain `node script.js` run/debug -->
        <configurationType implementation="com.nodespark.noderun.NodeAppRunConfigurationType"/>
        <programRunner implementation="com.nodespark.noderun.NodeAppProgramRunner"/>
        <programRunner implementation="com.nodespark.noderun.NodeAppDebugProgramRunner"/>
        <runConfigurationProducer implementation="com.nodespark.noderun.NodeAppRunConfigurationProducer"/>

        <!-- Attach the debugger to an already running node inspector -->
        <configurationType implementation="com.nodespark.attach.NodeAttachConfigurationType"/>
        <programRunner implementation="com.nodespark.debug.NodeAttachProgramRunner"/>

        <!-- package.json scripts: gutter icon + run configuration -->
        <configurationType implementation="com.nodespark.npm.NpmScriptRunConfigurationType"/>
        <programRunner implementation="com.nodespark.npm.NpmScriptProgramRunner"/>
        <runConfigurationProducer implementation="com.nodespark.npm.NpmScriptRunConfigurationProducer"/>
        <codeInsight.lineMarkerProvider
            language="any"
            implementationClass="com.nodespark.npm.NpmScriptLineMarkerProvider"/>

        <!-- Prettier as the Reformat Code (Ctrl+Alt+L) implementation for JS/TS -->
        <formattingService implementation="com.nodespark.lint.PrettierFormattingService"/>

        <!-- Weak warnings on code prettier would rewrite, with a reformat fix -->
        <externalAnnotator
            language="any"
            implementationClass="com.nodespark.lint.PrettierFormatAnnotator"/>

        <!-- Balloons from the formatting service when prettier fails on an explicit reformat -->
        <notificationGroup id="NodeSpark" displayType="BALLOON"/>

        <!-- ESLint inspection -->
        <externalAnnotator
            language="any"
            implementationClass="com.nodespark.lint.EslintExternalAnnotator"/>
        <applicationConfigurable
            parentId="com.nodespark.settings"
            instance="com.nodespark.lint.LintConfigurable"
            id="com.nodespark.lint"
            displayName="ESLint / Prettier"/>

        <!-- "npm install" banner on a project with no node_modules -->
        <editorNotificationProvider
            implementation="com.nodespark.notify.NodeModulesNotificationProvider"/>

        <!-- .env files: highlighting, completion, and a key/value grid beside the text editor -->
        <fileType name="DotEnv"
                  implementationClass="com.nodespark.env.EnvFileType"
                  fieldName="INSTANCE"
                  language="DotEnv"
                  fileNames=".env"
                  patterns=".env.*;*.env"/>
        <lang.parserDefinition language="DotEnv"
                               implementationClass="com.nodespark.env.EnvParserDefinition"/>
        <lang.syntaxHighlighterFactory language="DotEnv"
                                       implementationClass="com.nodespark.env.EnvSyntaxHighlighterFactory"/>
        <lang.commenter language="DotEnv" implementationClass="com.nodespark.env.EnvCommenter"/>
        <completion.contributor language="DotEnv"
                                implementationClass="com.nodespark.env.EnvCompletionContributor"/>
        <annotator language="DotEnv" implementationClass="com.nodespark.env.EnvDuplicateKeyAnnotator"/>
        <fileEditorProvider implementation="com.nodespark.env.EnvTableEditorProvider"/>
        <editorNotificationProvider implementation="com.nodespark.env.EnvTemplateNotificationProvider"/>

        <!-- describe/it outline in the Structure tool window -->
        <lang.psiStructureViewFactory
            language="any"
            implementationClass="com.nodespark.structure.NodeTestStructureViewFactory"/>

    </extensions>

    <applicationListeners>
        <listener class="com.nodespark.lint.PrettierOnSaveListener"
                  topic="com.intellij.openapi.fileEditor.FileDocumentManagerListener"/>
    </applicationListeners>

    <actions>
        <action id="NodeSpark.Prettier"
                class="com.nodespark.lint.PrettierFormatAction"
                text="Reformat with Prettier"
                description="Format the current file with the project's Prettier">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <keyboard-shortcut keymap="$default" first-keystroke="control alt shift P"/>
        </action>

        <action id="NodeSpark.NewEnvFromTemplate"
                class="com.nodespark.env.CreateEnvFromTemplateAction"
                text="New Env File from This..."
                description="Create another .env file with the keys of this one">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </action>

        <group id="NodeSpark.Coverage" text="Node Coverage" popup="true">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <action id="NodeSpark.RunTestsWithCoverage"
                    class="com.nodespark.coverage.RunTestsWithCoverageAction"
                    text="Run Tests with Coverage"/>
            <action id="NodeSpark.ShowCoverage"
                    class="com.nodespark.coverage.ShowNodeCoverageAction"
                    text="Show Coverage from lcov.info"/>
            <action id="NodeSpark.HideCoverage"
                    class="com.nodespark.coverage.HideNodeCoverageAction"
                    text="Hide Coverage"/>
        </group>
    </actions>
</idea-plugin>
