# Release secrets. Copy to .env and fill in — .env is gitignored and never leaves this machine.
# Every key is optional: an environment variable of the same name wins over the value here, so CI
# can keep using secrets and a local release can use this file.

# Marketplace API token, from https://plugins.jetbrains.com/author/me/tokens ("Generate Token").
# Shown once. Used by ./gradlew publishPlugin.
PUBLISH_TOKEN=

# Signing keypair. Generate once and keep it: every release should be signed by the same key.
#   openssl genpkey -aes-256-cbc -algorithm RSA -out secrets/private.pem -pkeyopt rsa_keygen_bits:4096
#   openssl req -key secrets/private.pem -new -x509 -days 3650 -out secrets/chain.crt
# secrets/ is gitignored. Paths are relative to the project root.
PRIVATE_KEY_FILE=secrets/private.pem
CERTIFICATE_CHAIN_FILE=secrets/chain.crt
PRIVATE_KEY_PASSWORD=

# Publish somewhere other than the stable channel — "eap" or "beta". Leave empty for a real release.
PUBLISH_CHANNEL=
