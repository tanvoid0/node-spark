# Gradle
.gradle/
build/
.kotlin/

# IntelliJ Platform Gradle plugin's local IDE cache
.intellijPlatform/

# IDE
.idea/
*.iml
local.properties

# The demo project is a run/debug fixture: its sources are tracked, its installed
# dependencies and generated coverage report are not.
demo/node_modules/
demo/coverage/

# IDE Features Trainer scratch, created when the demo project is opened
demo/ide-trainer/

# Release secrets: Marketplace token and the signing keypair. .env.example is the tracked template.
.env
secrets/

# Release helper scripts: they hold no secrets, but they only ever run on a maintainer's machine
# and they touch .env and secrets/, so they stay local. CONTRIBUTING has the commands they run.
scripts/
